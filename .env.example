# Copier vers .env.local pour le dev local (ne pas committer .env.local)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
# Si 587 échoue (Vercel / Infomaniak) : essayer SMTP_PORT=465
SMTP_USER=bot@secteurweb.com
SMTP_PASSWORD=
SMTP_FROM=bot@secteurweb.com
# Destinataire(s), virgules = plusieurs. Laisser vide / supprimer la clé = réception sur SMTP_USER.
# CONTACT_EMAIL_TO=
# Logs SMTP détaillés dans la console (Vercel → Functions logs) : 1 = activé
# SMTP_DEBUG=0

# Copier vers .env.local pour le dev local (ne pas committer .env.local)
# — Noms alignés sur Vercel (voir aussi SMTP_FROM si ton fournisseur l’exige) —
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=bot@secteurweb.com
SMTP_PASS=
# Boîte qui reçoit les demandes du formulaire (virgules = plusieurs adresses)
RECEIVER_EMAIL=bot@secteurweb.com
# Optionnel : expéditeur (sinon = SMTP_USER)
# SMTP_FROM=bot@secteurweb.com
# Alternative : SMTP_PORT=587 (STARTTLS)
# Compatibilité ancienne config : SMTP_PASSWORD, CONTACT_EMAIL_TO
# Logs SMTP détaillés (Vercel → Functions logs) : SMTP_DEBUG=1
